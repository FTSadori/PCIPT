<Window x:Class="PCIPT.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCIPT.Windows"
        mc:Ignorable="d"
        Title="PCIPT System: Authorization" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="Background">
            <Style.Setters>
                <Setter Property="TextBlock.Opacity" Value="0"/>
                <Setter Property="Panel.ZIndex" Value="5"/>
                <Setter Property="Grid.ColumnSpan" Value="3"/>
                <Setter Property="Grid.RowSpan" Value="4"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource RoundedTextBoxGrad}"/>
            </Style.Setters>
        </Style>

        <Style x:Key="PrettyText" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="TextBlock.FontFamily" Value="Century Gothic"/>
                <Setter Property="TextBlock.FontSize" Value="32"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource RoundedTextBoxGrad}"/>
            </Style.Setters>
        </Style>

        <Style x:Key="SmallPrettyText" BasedOn="{StaticResource PrettyText}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="TextBlock.FontSize" Value="16"/>
            </Style.Setters>
        </Style>

        <Style x:Key="LeftText" BasedOn="{StaticResource SmallPrettyText}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Left"/>
                <Setter Property="TextBlock.Margin" Value="20 0 0 0"/>
            </Style.Setters>
        </Style>

        <Style x:Key="RightText" BasedOn="{StaticResource SmallPrettyText}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Right"/>
                <Setter Property="TextBlock.Margin" Value="0 0 20 0"/>
            </Style.Setters>
        </Style>


        <LinearGradientBrush x:Key="RoundedTextBoxGrad" EndPoint="0,0.5" StartPoint="1,0.5">
            <GradientStop Color="#FF0F0062"/>
            <GradientStop Color="#FF0F0062" Offset="1"/>
            <GradientStop Color="#FF1A318F" Offset="0.528"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DisableGradient" EndPoint="0,0.5" StartPoint="1,0.5">
            <GradientStop Color="#992F4F4F"/>
            <GradientStop Color="#992F4F4F" Offset="1"/>
            <GradientStop Color="#99808080" Offset="0.528"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ErrorGradient" EndPoint="0,0.5" StartPoint="1,0.5">
            <GradientStop Color="DarkRed"/>
            <GradientStop Color="DarkRed" Offset="1"/>
            <GradientStop Color="#FFD20000" Offset="0.528"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="SuccessGradient" EndPoint="0,0.5" StartPoint="1,0.5">
            <GradientStop Color="DarkGreen"/>
            <GradientStop Color="DarkGreen" Offset="1"/>
            <GradientStop Color="Green" Offset="0.528"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundBrush" EndPoint="0,0.5" StartPoint="1,0.5">
            <GradientStop Color="#FF1F0037" Offset="0"/>
            <GradientStop Color="#FF1F0037" Offset="1"/>
            <GradientStop Color="#FF0F0050" Offset="0.2"/>
            <GradientStop Color="#FF0F0050" Offset="0.8"/>
        </LinearGradientBrush>

        <Style x:Key="RegButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="FontFamily" Value="Century Gothic"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="7 2 7 2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="TextBlock.FontFamily" Value="Century Gothic"/>
            <Setter Property="TextBlock.FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2 3 0 0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="TextBlock.FontFamily" Value="Century Gothic"/>
            <Setter Property="TextBlock.FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2 3 0 0"/>
        </Style>

        <Style x:Key="PrettyBorder" TargetType="Border">
            <Setter Property="Margin" Value="7 2 7 2"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style x:Key="PrettyCheckbox" TargetType="CheckBox">
            <Setter Property="Margin" Value="7 2 7 2"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="BorderThickness" Value="3"/>

            <Setter Property="Foreground" Value="{StaticResource RoundedTextBoxGrad}"/>
            <Setter Property="TextBlock.FontFamily" Value="Century Gothic"/>
            <Setter Property="TextBlock.FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 3 0 0"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="AuthorizationPanel">
            <Border CornerRadius="20 20 0 0" Height="60" Width="360.5" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                <Grid>
                    <Line X1="10" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="60" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="110" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="160" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="210" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="260" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="310" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="360" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="410" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>

                    <Line X1="-130" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="-80" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="-30" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="20" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="70" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="120" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="170" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="220" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="270" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="320" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="370" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="420" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource PrettyText}" Foreground="White">PCIPT</TextBlock>
                        <TextBlock Style="{DynamicResource SmallPrettyText}" Foreground="White" FontSize="12" Margin="0 -5 0 0">SYSTEM</TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="0 0 5 5" Background="White" Padding="20">
                <StackPanel Name="LoginStack" Orientation="Vertical" Visibility="Visible">
                    <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Login</TextBlock>

                    <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                        <TextBox Height="26" Name="LoginBox"></TextBox>
                    </Border>

                    <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Password</TextBlock>
                    <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                        <PasswordBox Height="26" Name="PasswordBox"></PasswordBox>
                    </Border>

                    <CheckBox Style="{DynamicResource PrettyCheckbox}" Name="RememberMeCheckBox" Width="300" Margin="10 3 10 10">Remember me</CheckBox>
                    <Button BorderThickness="0" Height="34" Style="{DynamicResource RegButton}" Name="LoginButton" Width="300" Margin="10 10 10 10" Click="LoginButton_Click">Log In</Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="AccountMenuPanel" Visibility="Hidden">
            <Border CornerRadius="20 20 0 0" Height="60" Width="640" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                <Grid>
                    <Line X1="10" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="60" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="110" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="160" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="210" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="260" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="310" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="360" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="410" X2="30" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>

                    <Line X1="-130" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="-80" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="-30" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="20" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="70" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="120" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="170" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="220" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="3" Opacity="0.05"/>
                    <Line X1="270" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="320" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="2" Opacity="0.05"/>
                    <Line X1="370" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Line X1="420" X2="240" Y1="64" Y2="-30" Stroke="White" StrokeThickness="1" Opacity="0.05"/>
                    <Grid Margin="20 0 20 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" Foreground="White">PCIPT</TextBlock>
                            <TextBlock Style="{DynamicResource SmallPrettyText}" Foreground="White" FontSize="12" Margin="0 -5 0 0">SYSTEM</TextBlock>
                        </StackPanel>
                        <TextBlock Name="GreetingText" Grid.Column="1" Style="{DynamicResource PrettyText}" FontSize="20" Foreground="White">Hello, user! (admin)</TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <Border CornerRadius="0 0 5 5" Background="White" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" FontSize="18" TextAlignment="Center">Manage account</TextBlock>
                        <Button BorderThickness="0" Height="30" FontSize="16" Style="{DynamicResource RegButton}" Name="ChangePasswordButton" Width="280" Margin="0 7 0 5" Click="ChangePasswordButton_Click">Change password</Button>
                        <Button BorderThickness="0" Height="30" FontSize="16" Style="{DynamicResource RegButton}" Name="LogOffButton" Width="280" Margin="0 5 0 10" Click="LogOffButton_Click">Log off</Button>
                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" FontSize="18" TextAlignment="Center" Name="AdminOptionsText" Visibility="Collapsed">Admin options</TextBlock>
                        <Button BorderThickness="0" Height="30" FontSize="16" Style="{DynamicResource RegButton}" Name="AddNewAccountButton" Width="280" Margin="0 7 0 5" Click="AddNewAccountButton_Click" Visibility="Collapsed">Create new account</Button>
                        <Button BorderThickness="0" Height="30" FontSize="16" Style="{DynamicResource RegButton}" Name="ManageAccountsButton" Width="280" Margin="0 5 0 5" Click="ManageAccountsButton_Click" Visibility="Collapsed">Manage accounts</Button>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" FontSize="18" TextAlignment="Center">Modules</TextBlock>
                        <Button IsEnabled="True" BorderThickness="0" Height="34" Style="{DynamicResource RegButton}" Name="PlannerButton" Width="280" Margin="0 7 0 5" Click="PlannerButton_Click">Open planner module</Button>
                        <Border Name="PlannerBorder" Width="260" Margin="0 -5.5 0 0" CornerRadius="0 0 10 10" BorderBrush="#FF251D66" BorderThickness="2">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF251D66" FontSize="12" Style="{DynamicResource SmallPrettyText}">Planner module allows you to blah blah blah. Planner module allows you to blah blah blah</TextBlock>
                        </Border>
                        <Button IsEnabled="True" BorderThickness="0" Height="34" Style="{DynamicResource RegButton}" Name="DispatcherButton" Width="280" Margin="0 10 0 5" Click="DispatcherButton_Click">Open dispatcher module</Button>
                        <Border Name="DispatcherBorder"  Width="260" Margin="0 -5.5 0 0" CornerRadius="0 0 10 10" BorderBrush="#FF251D66" BorderThickness="2">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF251D66" FontSize="12" Style="{DynamicResource SmallPrettyText}">Dispatcher module allows you to blah blah blah. Dispatcher module allows you to blah blah blah</TextBlock>
                        </Border>
                        <!--
                    <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                        <TextBox Height="26" Name="LoginBox"></TextBox>
                    </Border>

                    <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Password</TextBlock>
                    <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                        <PasswordBox Height="26" Name="PasswordBox"></PasswordBox>
                    </Border>

                    <CheckBox Style="{DynamicResource PrettyCheckbox}" Name="RememberMeCheckBox" Width="300" Margin="10 3 10 10">Remember me</CheckBox>
                    <Button BorderThickness="0" Height="34" Style="{DynamicResource RegButton}" Name="LoginButton" Width="300" Margin="10 10 10 10" Click="LoginButton_Click">Log In</Button>
                    -->
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Background="#33000000" Visibility="Hidden" Name="ManageAccountPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="ManageAccountPanelGrid">
                <Border CornerRadius="20 20 0 0" Height="40" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="22" Foreground="White">Manage accounts</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 15">
                    <StackPanel Orientation="Vertical">
                        <Border BorderThickness="0 0 0 3" BorderBrush="{DynamicResource RoundedTextBoxGrad}" Margin="0 0 17 0">
                            <StackPanel Orientation="Horizontal">
                                <Border BorderThickness="0 0 1 0" BorderBrush="{DynamicResource RoundedTextBoxGrad}" Width="30">
                                    <TextBlock Style="{DynamicResource SmallPrettyText}" TextAlignment="Left" Margin="5 0 0 0">№</TextBlock>
                                </Border>
                                <Border BorderThickness="0 0 1 0" BorderBrush="{DynamicResource RoundedTextBoxGrad}" Width="230">
                                    <TextBlock Style="{DynamicResource SmallPrettyText}" TextAlignment="Left" Margin="5 0 0 0">Login</TextBlock>
                                </Border>
                                <Border BorderThickness="0 0 1 0" BorderBrush="{DynamicResource RoundedTextBoxGrad}" Width="120">
                                    <TextBlock Style="{DynamicResource SmallPrettyText}" TextAlignment="Left" Margin="5 0 0 0">Role</TextBlock>
                                </Border>
                                <Border BorderThickness="0 0 0 0" BorderBrush="{DynamicResource RoundedTextBoxGrad}" Width="100">
                                    <TextBlock Style="{DynamicResource SmallPrettyText}" TextAlignment="Left" Margin="5 0 0 0">Option</TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Visible" MinHeight="150" MaxHeight="270">
                            <StackPanel Orientation="Vertical" Name="AccountsStack">
                            </StackPanel>
                        </ScrollViewer>
                        <Button Margin="0 10 0 0" BorderThickness="0" FontSize="16" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="ManageAccountsBack" Click="ManageAccountsBack_Click" Width="100">Back</Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Background="#33000000" Visibility="Hidden" Name="AccountOptionsPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="AccountOptionsGrid">
                <Border CornerRadius="20 20 0 0" Height="40" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Name="AccountOptionsLabel" Style="{DynamicResource PrettyText}" FontSize="22" Foreground="White">Users's options</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 15">
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <Button BorderThickness="0" FontSize="14" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="AccountOptionsResetPasswordButton" Width="200" Click="AccountOptionsResetPasswordButton_Click">Reset password</Button>
                        <Button BorderThickness="0" FontSize="14" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource ErrorGradient}" Name="AccountOptionsDeleteAccountButton" Width="200" Click="AccountOptionsDeleteAccountButton_Click">Delete account</Button>
                        <Button BorderThickness="0" Margin="10 10 10 0" FontSize="14" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="AccountOptionsCloseButton" Width="100" Click="AccountOptionsCloseButton_Click">Back</Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Background="#33000000" Visibility="Hidden" Name="YesNoPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="YesNoGrid">
                <Border CornerRadius="5" Background="White" Padding="15 15 15 15" Width="200">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="0 0 0 10" Style="{DynamicResource SmallPrettyText}" Foreground="{DynamicResource RoundedTextBoxGrad}" FontSize="16" TextWrapping="Wrap">Delete Admin's account?</TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button BorderThickness="0" FontSize="14" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="YesNoBack" Width="70" Click="YesNoBack_Click">Back</Button>
                            <Button BorderThickness="0" FontSize="14" Height="24" Style="{DynamicResource RegButton}" Background="{DynamicResource ErrorGradient}" Name="YesNoAgree" Width="70" Click="YesNoAgree_Click">Delete</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>


        <Grid Background="#33000000" Visibility="Hidden" Name="CreateNewAccountBackground">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="CreateNewAccountGrid">
                <Border CornerRadius="20 20 0 0" Height="40" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="22" Foreground="White">Create new account</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 0">
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Username</TextBlock>

                        <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                            <TextBox Height="26" Name="CreateAccountName"></TextBox>
                        </Border>

                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Role</TextBlock>

                        <ComboBox Name="CreateAccountRole"  Height="34" FontFamily="Century Gothic" Margin="10 3 10 10" FontSize="18" Foreground="{StaticResource PrettyBlueGradient}" Width="300" Style="{DynamicResource PrettyComboBox}" BorderBrush="{DynamicResource RoundedTextBoxGrad}" BorderThickness="3">
                            <ComboBox.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Color="#FFF0F0F0"/>
                                    <GradientStop Color="#00E5E5E5" Offset="1"/>
                                </LinearGradientBrush>
                            </ComboBox.Background>
                            <ComboBoxItem FontSize="16">Dispatcher</ComboBoxItem>
                            <ComboBoxItem FontSize="16">Planner</ComboBoxItem>
                            <ComboBoxItem FontSize="16">Full access</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Password</TextBlock>

                        <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                            <TextBox Height="26" Name="CreateAccountGeneratedPassword"></TextBox>
                        </Border>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 10">
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="CreateAccountBack" Click="CreateAccountBack_Click" Width="100">Back</Button>
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="CreateAccountSubmit" Click="CreateAccountSubmit_Click" Width="100">Submit</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <Grid Background="#33000000" Visibility="Hidden" Name="ChangePasswordBackground">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="ChangePasswordGrid">
                <Border CornerRadius="20 20 0 0" Height="40" Background="{DynamicResource RoundedTextBoxGrad}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="22" Foreground="White">Change password</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 0">
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Old password</TextBlock>

                        <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                            <PasswordBox Height="26" Name="ChangePassword1Box"></PasswordBox>
                        </Border>

                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">New password</TextBlock>
                        <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                            <PasswordBox Height="26" Name="ChangePassword2Box"></PasswordBox>
                        </Border>

                        <TextBlock Width="300" Style="{DynamicResource SmallPrettyText}" TextAlignment="Left">Repeat new password</TextBlock>
                        <Border Style="{DynamicResource PrettyBorder}" Width="300" Margin="10 3 10 10">
                            <PasswordBox Height="26" Name="ChangePassword3Box"></PasswordBox>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 10">
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="CloseChangePasswordButton" Width="100" Click="CloseChangePasswordButton_Click">Back</Button>
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource RoundedTextBoxGrad}" Name="SubmitChangePasswordButton" Width="100" Click="SubmitChangePasswordButton_Click">Submit</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Background="#33000000" Visibility="Hidden" Name="SuccessBackground">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="SuccessGrid">
                <Border CornerRadius="20 20 0 0" Height="36" Background="{DynamicResource SuccessGradient}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="26" Foreground="White">Success</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 0">
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <TextBlock Name="SuccessText" Margin="0 0 0 10" Width="250" Style="{DynamicResource SmallPrettyText}" Foreground="{DynamicResource SuccessGradient}" FontSize="18" TextWrapping="Wrap">Error message good error message good error message</TextBlock>
                        <Grid HorizontalAlignment="Center" Margin="0 5 0 10">
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource SuccessGradient}" Width="100" Name="SuccessOkayButton" Click="SuccessOkayButton_Click">Okay</Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        
        <Grid Background="#33000000" Visibility="Hidden" Name="ErrorBackground">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Name="ErrorGrid">
                <Border CornerRadius="20 20 0 0" Height="36" Background="{DynamicResource ErrorGradient}" ClipToBounds="True">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="26" Foreground="White">Error</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border CornerRadius="0 0 5 5" Background="White" Padding="15 15 15 0">
                    <StackPanel Orientation="Vertical" Visibility="Visible">
                        <TextBlock Name="ErrorText" Margin="0 0 0 10" Width="250" Style="{DynamicResource SmallPrettyText}" Foreground="{DynamicResource ErrorGradient}" FontSize="18" TextWrapping="Wrap">Error message good error message good error message</TextBlock>
                        <Grid HorizontalAlignment="Center" Margin="0 5 0 10">
                            <Button Visibility="Hidden" BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource ErrorGradient}" Width="100" Name="OkayButton" Click="OkayButton_Click">Try again</Button>
                            <Button BorderThickness="0" FontSize="18" Height="30" Style="{DynamicResource RegButton}" Background="{DynamicResource ErrorGradient}" Width="100" Name="RetryButton" Click="RetryButton_Click">Retry</Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
