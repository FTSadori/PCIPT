<Window x:Class="PCIPT.Windows.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCIPT.Windows"
        mc:Ignorable="d"
        Title="GraphWindow" Height="450" Width="800" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Canvas Name="GraphCanvas" Grid.RowSpan="2" Grid.Column="1">
        </Canvas>

        <Canvas Name="VehiclesGraphCanvas" Grid.RowSpan="2" Grid.Column="1">
        </Canvas>

        <Grid Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="60" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Button Grid.Column="1" Grid.Row="0" Click="Up_Click">▲</Button>
            <Button Grid.Column="0" Grid.Row="1" Click="Left_Click">◄</Button>
            <Button Grid.Column="2" Grid.Row="1" Click="Right_Click">►</Button>
            <Button Grid.Column="1" Grid.Row="2" Click="Down_Click">▼</Button>
            <Button Grid.Column="1" Grid.Row="1" Click="SetDefault_Click">○</Button>
            <StackPanel Grid.ColumnSpan="3" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Grid.Column="0" Grid.Row="1" Width="20" Click="SizeMinus_Click">-</Button>
                <Button Grid.Column="2" Grid.Row="1" Width="20" Click="SizePlus_Click">+</Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.RowSpan="2" Background="LightGray"></TextBlock>
        <StackPanel Orientation="Vertical" Margin="10" Background="White">
            <TextBlock FontSize="16" Margin="0 0 0 5">Legend</TextBlock>
            <StackPanel Orientation="Vertical" CanHorizontallyScroll="True">
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="10" Grid.Row="1" Background="White">
            <TextBlock FontSize="16" Margin="0 0 0 5">Selected vehicle</TextBlock>
            <StackPanel Orientation="Vertical" CanHorizontallyScroll="True">
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
