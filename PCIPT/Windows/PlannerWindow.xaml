<Window x:Class="PCIPT.Windows.PlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCIPT.Windows"
        mc:Ignorable="d"
        Title="PCIPT System: Planner window" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Button Style="{DynamicResource RegButton}" Height="40" Width="300" Name="InputDataButton" Click="InputDataButton_Click">Import</Button>
        <TextBlock Style="{StaticResource PrettyText}" Margin="0 -100 0 0" FontSize="24" Name="TestMessage"></TextBlock>
    </Grid>
</Window>
