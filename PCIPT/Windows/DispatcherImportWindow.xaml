<Window x:Class="PCIPT.Windows.DispatcherImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCIPT.Windows"
        mc:Ignorable="d"
        Title="PCIPT System: Dispatcher Import" Height="460" Width="600">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBlock Width="600" Style="{DynamicResource PrettyText}" FontSize="26" Foreground="White" Background="{StaticResource RoundedTextBoxGrad}" Height="45" Padding="0 8 0 0">Import dispatching data</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="220" TextAlignment="Right" Foreground="{StaticResource RoundedTextBoxGrad}">Shift time fund (m)</TextBlock>
                <Border Style="{StaticResource PrettyBorder}" Width="60" Height="22" BorderThickness="1">
                    <TextBox CaretBrush="Black" FontFamily="Century Gothic" FontSize="16" Margin="0" Name="DailyTimeFundTextBox">
                        480
                    </TextBox>
                </Border>
            </StackPanel>
            <Grid Margin="0 12 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Name="ByPlanLabel" Style="{StaticResource PrettyBorder}" Height="30" BorderThickness="0" CornerRadius="4 4 0 0" Width="150" Background="#FF172382">
                        <TextBlock Style="{StaticResource SmallPrettyText}" Foreground="White">By plan</TextBlock>
                    </Border>
                    <Border Name="ByAutomaticLabel" Visibility="Collapsed" Style="{StaticResource PrettyBorder}" Height="30" BorderThickness="0" CornerRadius="4 4 0 0" Width="150" Background="#FF172382">
                        <TextBlock Style="{StaticResource SmallPrettyText}" Foreground="White">Automatic</TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="ByPlanButton" Click="ByPlanButton_Click" Visibility="Hidden" Style="{StaticResource RegButton}" Height="26" BorderThickness="2" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="150" FontSize="16">By plan</Button>
                    <Button Name="ByAutomaticButton" Click="ByAutomaticButton_Click" Visibility="Collapsed" Style="{StaticResource RegButton}" Height="26" BorderThickness="2" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="150" FontSize="16">Automatic</Button>
                </StackPanel>
            </Grid>
            <Border Name="AutomaticGrid" Visibility="Collapsed" Style="{StaticResource PrettyBorder}" Margin="0 -3 0 0" Background="{StaticResource RoundedTextBoxGrad}" BorderThickness="0" Width="400">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Vehicle needs</TextBlock>
                                <Button Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Name="PlanGrid" Visibility="Visible" Style="{StaticResource PrettyBorder}" Margin="0 -3 0 0" Background="{StaticResource RoundedTextBoxGrad}" BorderThickness="0" Width="560">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Width="175">Distributed tasks</TextBlock>
                            <Button Name="ImportDistributed" Click="ImportDistributed_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Width="175">Shift cargo points</TextBlock>
                            <Button Name="ImportDailyCargo" Click="ImportDailyCargo_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Margin="0 12 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Name="CsvSelected" Style="{StaticResource PrettyBorder}" Height="30" BorderThickness="0" CornerRadius="4 4 0 0" Width="150" Background="#FF172382">
                        <TextBlock Style="{StaticResource SmallPrettyText}" Foreground="White">From CSV</TextBlock>
                    </Border>
                    <Border Name="DatabaseSelected" Visibility="Hidden" Style="{StaticResource PrettyBorder}" Height="30" BorderThickness="0" CornerRadius="4 4 0 0" Width="150" Background="#FF172382">
                        <TextBlock Style="{StaticResource SmallPrettyText}" Foreground="White">From Database</TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="CsvButton" Click="CsvButton_Click" Visibility="Hidden" Style="{StaticResource RegButton}" Height="26" BorderThickness="2" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="150" FontSize="16">From CSV</Button>
                    <Button Name="DatabaseButton" Click="DatabaseButton_Click" Style="{StaticResource RegButton}" Height="26" BorderThickness="2" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="150" FontSize="16">From Database</Button>
                </StackPanel>
            </Grid>
            <Border Visibility="Collapsed" Name="BorderDatabase" Style="{StaticResource PrettyBorder}" Margin="0 -3 0 0" Background="{StaticResource RoundedTextBoxGrad}" BorderThickness="0" Width="560">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Nodes coordinates</TextBlock>
                                <TextBlock Name="Indicator1" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Fuel vehicles</TextBlock>
                                <TextBlock Name="Indicator2" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Electric vehicles</TextBlock>
                                <TextBlock Name="Indicator3" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Routes data</TextBlock>
                                <TextBlock Name="Indicator4" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Cargoes data</TextBlock>
                                <TextBlock Name="Indicator5" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Vehicle types</TextBlock>
                                <TextBlock Name="Indicator7" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Nodes data</TextBlock>
                                <TextBlock Name="Indicator8" Style="{DynamicResource PrettyText}" FontSize="16" Width="70" TextAlignment="Right" Foreground="White" Margin="0 0 5 0" Opacity="0.7">Empty</TextBlock>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                    <Button Name="ImportDatabaseButton" Click="ImportDatabaseButton_Click"  Style="{StaticResource RegButton}" Margin="5" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="300" FontSize="16">Import from connected database</Button>
                </StackPanel>
            </Border>
            <Border Visibility="Visible" Name="BorderCsv" Style="{StaticResource PrettyBorder}" Margin="0 -3 0 0" Background="{StaticResource RoundedTextBoxGrad}" BorderThickness="0" Width="560">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Nodes coordinates</TextBlock>
                            <Button Name="CsvButton1" Click="CsvButton1_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Fuel vehicles</TextBlock>
                            <Button Name="CsvButton2" Click="CsvButton2_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Electric vehicles</TextBlock>
                            <Button Name="CsvButton3" Click="CsvButton3_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Routes data</TextBlock>
                            <Button Name="CsvButton4" Click="CsvButton4_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="5 0 5 0">
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Cargoes data</TextBlock>
                            <Button Name="CsvButton5" Click="CsvButton5_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Vehicle types</TextBlock>
                            <Button Name="CsvButton7" Click="CsvButton7_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <TextBlock Style="{DynamicResource PrettyText}" FontSize="16" Width="175" TextAlignment="Right" Foreground="White" Margin="0 0 5 0">Nodes data</TextBlock>
                            <Button Name="CsvButton8" Click="CsvButton8_Click" Style="{StaticResource RegButton}" Height="24" BorderThickness="1" Background="White" Foreground="{StaticResource RoundedTextBoxGrad}" Width="70" FontSize="16">Import</Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Margin="10" Style="{StaticResource RegButton}" Background="{StaticResource DisableGradient}" BorderThickness="0" Foreground="White" Width="200" FontSize="18" Height="30" IsEnabled="False" Name="StartPlanningButton" Click="StartPlanningButton_Click">Apply</Button>
        </StackPanel>
    </Grid>
</Window>
